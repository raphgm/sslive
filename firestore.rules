rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Quiz Rules
    match /quizzes/{quizId} {
      allow get: if true;
      allow list: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if isSignedIn() &&
                    incoming().teacherId == request.auth.uid &&
                    incoming().title is string &&
                    incoming().title.size() <= 100;
      allow update: if isSignedIn() &&
                    existing().teacherId == request.auth.uid &&
                    incoming().teacherId == request.auth.uid &&
                    incoming().title is string &&
                    incoming().title.size() <= 100;
      allow delete: if isSignedIn() &&
                    existing().teacherId == request.auth.uid;
    }

    // Room Rules
    match /rooms/{roomId} {
      allow get: if true; // anyone can fetch room status
      allow list: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if isSignedIn() &&
                    incoming().teacherId == request.auth.uid &&
                    roomId == incoming().roomId;
      allow update: if (isSignedIn() && existing().teacherId == request.auth.uid && incoming().teacherId == request.auth.uid);
      allow delete: if isSignedIn() &&
                    existing().teacherId == request.auth.uid;

      // Sub-collection: Participants
      match /participants/{participantId} {
        allow get, list, create: if true; // anyone can get details, teachers list them, students join
        // For update: Student can update their progress, score, answers, completed etc.
        allow update: if true;
        // Only the room teacher can kick participants (delete them)
        allow delete: if isSignedIn() &&
                      get(/databases/$(database)/documents/rooms/$(roomId)).data.teacherId == request.auth.uid;
      }
    }

    // Reports History Rules
    match /reports_history/{reportId} {
      allow get, list: if isSignedIn() && (resource == null || !("teacherId" in resource.data) || resource.data.teacherId == request.auth.uid);
      allow create: if isSignedIn() &&
                    incoming().teacherId == request.auth.uid &&
                    reportId == incoming().id &&
                    incoming().roomCode is string &&
                    incoming().roomCode.size() <= 100 &&
                    incoming().quizTitle is string &&
                    incoming().quizTitle.size() <= 200 &&
                    incoming().endedAt is string &&
                    incoming().endedAt.size() <= 100;
      allow delete: if isSignedIn() &&
                    existing().teacherId == request.auth.uid;
    }
  }
}
